{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:stage1": "tsx tests/verify-stage1.mjs",
    "verify:stage2": "tsx tests/verify-stage2.mjs",
    "verify:notes": "tsx tests/verify-notes.mjs",
    "verify:stage3": "tsx tests/verify-stage3.mjs",
    "verify:security": "tsx tests/verify-security.mjs",
    "verify:rates-csv": "tsx tests/verify-rates-csv.mjs",
    "verify:practice": "tsx tests/verify-practice.mjs",
    "verify:backup": "tsx tests/verify-backup.mjs",
    "verify:residences": "tsx tests/verify-residences.mjs"
  },
  "dependencies": {
    "@google-cloud/storage": "^8.4.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "drizzle-orm": "catalog:",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "google-auth-library": "^11.3.1",
    "jszip": "^3.10.2",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "puppeteer-core": "^25.14.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/supertest": "^7.2.1",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pdfjs-dist": "^6.4.299",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.3.1",
    "thread-stream": "3.1.0",
    "tsx": "catalog:"
  }
}
